NODE_ENV=development
PORT=4000
# Origin of the Next.js frontend (used for CORS and links in emails)
APP_URL=http://localhost:30001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=accountanz

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Password for seeded demo users (db:seed)
SEED_PASSWORD=

# Vercel Blob read-write token for the private file store (agreements, documents)
BLOB_READ_WRITE_TOKEN=

# Email (Resend). Use a sending-only key. Without a key, emails are written to the log.
RESEND_API_KEY=
# Until a domain is verified in Resend only onboarding@resend.dev works, and only to the account owner.
MAIL_FROM=Accountanz <onboarding@resend.dev>
# Development only: deliver every email to this inbox instead of the real recipient.
MAIL_REDIRECT_TO=

# JournL API used by "Sign in with JournL" when a client owner connects their organisation
JOURNL_API_URL=https://testapi.bizpolebooks.com
# 32-byte base64 key for stored JournL tokens: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOURNL_TOKEN_KEY=

# Extra browser origins allowed by CORS (comma-separated), e.g. a dev tunnel. Optional.
CORS_ORIGINS=

# "Open in JournL": JournL's web sign-in address (https). JournL picks the company from the login, not the URL;
# {companyId} is filled in if it ever supports per-company links. No token is ever added. Empty = button says not set up.
JOURNL_APP_URL_TEMPLATE=

# Whole JournL integration (connection codes, JournL Books, corrections, JournL access). Off by default:
# accountants sign in to JournL directly, and Accountanz only shows "Open in JournL" (JOURNL_APP_URL_TEMPLATE).
# Keep in step with the frontend's NEXT_PUBLIC_JOURNL_INTEGRATION.
JOURNL_INTEGRATION_ENABLED=false

# JournL corrections (writes to the client's JournL books). Off by default.
# Writes happen only when JOURNL_WRITES_ENABLED=true AND the JOURNL_API_URL host is listed in JOURNL_WRITE_HOSTS.
JOURNL_WRITES_ENABLED=false
# Comma-separated JournL API hostnames writes are allowed against (test environment only by default).
JOURNL_WRITE_HOSTS=testapi.bizpolebooks.com
